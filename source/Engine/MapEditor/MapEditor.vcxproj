<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{248D610E-BEDE-4C49-AFD7-43F90E5F4B54}</ProjectGuid>
    <RootNamespace>MapEditor</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="..\Engine.props" />
  </ImportGroup>
  <!--
    The map editor's model and views on Genesis UI: the document (map core
    objects, selection, undo), the map views (SViewport clients drawing the
    map core's View through the RHI) and the game sets. The map core headers
    (Basic, Objects, Render, Game) are older C++: they are compiled without
    conformance mode, like MapCore itself.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ConformanceMode>false</ConformanceMode>
      <PreprocessorDefinitions>__MSC__;_CRT_NONSTDC_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(GenesisEngineDir)Core\Public;$(GenesisEngineDir)ApplicationCore\Public;$(GenesisEngineDir)RHI\Public;$(GenesisEngineDir)UICore\Public;$(GenesisEngineDir)UI\Public;$(GenesisEngineDir)UIRenderer\Public;$(GenesisSourceDir)Basic;$(GenesisSourceDir)Objects;$(GenesisSourceDir)Render;$(GenesisSourceDir)Game;$(ProjectDir)Public;$(ProjectDir)Private;$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Private\MapDocument.cpp" />
    <ClCompile Include="Private\MapDraw.cpp" />
    <ClCompile Include="Private\MapEditorEnvironment.cpp" />
    <ClCompile Include="Private\MapViewportClient.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Private\MapEditorPrivate.h" />
    <ClInclude Include="Private\Shaders\MapShaders_PSColor_SPIRV.h" />
    <ClInclude Include="Private\Shaders\MapShaders_VSMain_SPIRV.h" />
    <ClInclude Include="Public\MapDocument.h" />
    <ClInclude Include="Public\MapDraw.h" />
    <ClInclude Include="Public\MapEditorEnvironment.h" />
    <ClInclude Include="Public\MapViewportClient.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Private\Shaders\BuildMapShaders.cmd" />
  </ItemGroup>
  <ItemGroup>
    <CustomBuild Include="Private\Shaders\MapShaders.hlsl">
      <Command>&quot;$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe&quot; -nologo -O3 -T vs_6_0 -E VSMain -Vn g_MapShaders_VSMain_DXIL -Fh &quot;$(IntDir)MapShaders_VSMain_DXIL.h&quot; &quot;%(FullPath)&quot;
&quot;$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe&quot; -nologo -O3 -T ps_6_0 -E PSColor -Vn g_MapShaders_PSColor_DXIL -Fh &quot;$(IntDir)MapShaders_PSColor_DXIL.h&quot; &quot;%(FullPath)&quot;</Command>
      <Outputs>$(IntDir)MapShaders_VSMain_DXIL.h;$(IntDir)MapShaders_PSColor_DXIL.h</Outputs>
      <Message>Compiling %(Filename)%(Extension) to DXIL</Message>
    </CustomBuild>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
