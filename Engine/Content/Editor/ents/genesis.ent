//
//  Genesis entity set: the few engine-neutral entities the map editor
//  offers until Genesis Engine defines its own (the format is Qoole's:
//  class, typedef, flagdef and entity blocks; see Objects/EntList.cpp).
//

class "Info"
class "Light"
class "Player"

entity "worldspawn" "Null->Worldspawn" "The map itself"
{
	"message"	str		"The title of the map"
	model
}

entity "info_player_start" "Player->Start" "Where the player starts"
{
	"origin"	notuser
	"angle"		int		"Direction the player faces, in degrees"
	gem "gems/player.gem"
}

entity "info_null" "Info->Null" "A named position other entities can target"
{
	"origin"	notuser
	"targetname"	str		"Name other entities use to target this one"
}

typedef "light_styles"
{
	0	"Steady"
	1	"Flicker"
	2	"Slow strong pulse"
	3	"Candle"
	4	"Fast strobe"
	5	"Gentle pulse"
}

flagdef "light_flags"
{
	1	"Start off"
}

entity "light" "Light->Point Light" "A point light"
{
	"origin"	notuser
	"light"		int (300)	"Brightness"
	"_color"	str		"Color as three numbers from 0 to 1"
	"style"		light_styles	"How the light changes over time"
	"spawnflags"	light_flags	"How the light starts"
	"targetname"	str		"Name other entities use to target this one"
	gem "gems/light.gem"
}
